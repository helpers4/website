 * Copyright (C) 2025 baxyz
 * SPDX-License-Identifier: LGPL-3.0-or-later
 *
 * Landing page — statically generated, no JS hydration.
 * GitHub stars are fetched at build time.
 */

import ProjectCard, { type ProjectCard as ProjectCardType } from '../components/ProjectCard.astro';
import { getRepoStats } from '../lib/repoStats';

const PROJECTS: ProjectCardType[] = [
  {
    title: 'TypeScript & JS',
    label: 'TypeScript',
    description: 'Tree-shakable, strictly-typed utilities — general-purpose and domain-specific, zero deps.',
    docsHref: '/typescript/',
    repoPath: 'helpers4/typescript',
  },
  {
    title: 'Dev Container',
    label: 'Dev Container',
    description: 'Plug-and-play features for consistent, reproducible development environments.',
    docsHref: '/devcontainer/',
    repoPath: 'helpers4/devcontainer',
  },
  {
    title: 'GitHub Actions',
    label: 'GitHub Actions',
    description: 'Reusable Actions for commit validation, CI automation, and release workflows.',
    docsHref: '/action/',
    repoPath: 'helpers4/action',
  },
];

const statsEntries = await Promise.all(
  PROJECTS.map(async (p) => [p.repoPath, await getRepoStats(p.repoPath)] as const),
);
const starsMap = Object.fromEntries(statsEntries.map(([repoPath, stats]) => [repoPath, stats.stars]));
const scorecardMap = Object.fromEntries(statsEntries.map(([repoPath, stats]) => [repoPath, stats.scorecard]));
const coverageMap = Object.fromEntries(statsEntries.map(([repoPath, stats]) => [repoPath, stats.coverage]));

interface UnsplashPhoto {
  url: string;
  photographerName: string;
  photographerUrl: string;
}

/**
 * One random "technology, abstract" photo per build (not per visitor) — fetched at build time so
 * the Unsplash Access Key never reaches the client and the site stays static/JS-free. Falls back
 * to no photo (plain background) if UNSPLASH_ACCESS_KEY isn't set or the request fails for any
 * reason. Per Unsplash's API guidelines, using a photo requires visible attribution (handled in
 * the markup below) and a ping to its download-tracking endpoint (handled here).
 */
async function fetchRandomHeroPhoto(): Promise<UnsplashPhoto | null> {
  const accessKey = import.meta.env.UNSPLASH_ACCESS_KEY;
  if (!accessKey) return null;
  try {
    const headers = { Authorization: `Client-ID ${accessKey}` };
    const res = await fetch(
      'https://api.unsplash.com/photos/random?query=technology,abstract&orientation=landscape&content_filter=high',
      { headers },
    );
    if (!res.ok) return null;
    const data = (await res.json()) as {
      urls?: { regular?: string };
      user?: { name?: string; links?: { html?: string } };
      links?: { download_location?: string };
    };
    if (!data.urls?.regular || !data.user?.name || !data.user.links?.html || !data.links?.download_location) {
      return null;
    }
    // Required by Unsplash's API guidelines whenever a photo obtained via the API is displayed.
    fetch(data.links.download_location, { headers }).catch(() => {});
    return { url: data.urls.regular, photographerName: data.user.name, photographerUrl: data.user.links.html };
  } catch {
    return null;
  }
}

const heroPhoto = await fetchRandomHeroPhoto();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>helpers4 — Open-source developer tools</title>
    <meta name="description" content="Open-source developer tools built for real projects: TypeScript utilities, Dev Container features, GitHub Actions." />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="helpers4" />
    <meta property="og:description" content="Open-source developer tools built for real projects." />
    <meta property="og:image" content="/helpers4-logo.png" />
  </head>
  <body class:list={{ 'has-photo': heroPhoto }} style={heroPhoto ? `--hero-image: url(${heroPhoto.url})` : undefined}>
    {heroPhoto && (
      <p class="hero-credit">
        Photo by <a href={`${heroPhoto.photographerUrl}?utm_source=helpers4&utm_medium=referral`} target="_blank" rel="noopener noreferrer">{heroPhoto.photographerName}</a>
        {' '}on <a href="https://unsplash.com/?utm_source=helpers4&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
      </p>
    )}

    <div class="page">
      <header class="site-header">
        <img src="/helpers4-logo.png" alt="helpers4" class="logo" width="56" height="56" />
        <h1>helpers4</h1>
      </header>

      <section class="intro">
        <p>
          Open-source developer tools built for real projects.
        </p>
        <p class="license-note">
          Free to use under the LGPL-3.0 license, including in commercial products.
          Distribute modified source? Share those changes. Run it as a service? No obligations.
        </p>
      </section>

      <section class="cards-grid">
        {PROJECTS.map((project) => (
          <ProjectCard
            card={project}
            stars={starsMap[project.repoPath] ?? null}
            scorecard={scorecardMap[project.repoPath] ?? null}
            coverage={coverageMap[project.repoPath] ?? null}
          />
        ))}
      </section>

      <footer class="site-footer">
        <p>
          <a href="/blog">Blog</a>
          &nbsp;·&nbsp;
          <a href="https://github.com/helpers4" target="_blank" rel="noopener noreferrer">GitHub</a>
        </p>
      </footer>
    </div>

    <p class="copyright-credit">
      © 2025 helpers4 · <a href="/typescript/legal/license">LGPL-3.0</a>
    </p>
  </body>
</html>

<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  :root {
    --accent: #2d6ef6;
    --accent-dark: #1d4ed8;
    --text: #1a1a2e;
    --text-muted: #64748b;
    --bg: #ffffff;
    --border: #e2e8f0;
    --bg-card: #f8fafc;
    --radius: 0.75rem;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --text: #f1f5f9;
      --text-muted: #94a3b8;
      --bg: #0f172a;
      --border: #1e293b;
      --bg-card: #1e293b;
    }
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
  }

  /* Overriding just these two tokens re-colors everything on the page that already reads them
     (headings, intro text, footer, and — via the .cards-grid override block below — card text
     too), so the photo doesn't need per-element color overrides. */
  body.has-photo {
    --text: #fff;
    --text-muted: rgba(255, 255, 255, 0.75);
    background-image: linear-gradient(180deg, rgba(15, 23, 42, 0.72), rgba(15, 23, 42, 0.55)), var(--hero-image);
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
  }

  .hero-credit {
    position: fixed;
    bottom: 0.5rem;
    right: 0.75rem;
    z-index: 1;
    margin: 0;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .hero-credit a {
    color: inherit;
  }

  .copyright-credit {
    position: fixed;
    bottom: 0.5rem;
    left: 0.75rem;
    z-index: 1;
    margin: 0;
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .copyright-credit a {
    color: inherit;
  }

  .page {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  .site-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .logo {
    height: 56px;
    width: auto;
  }

  h1 {
    margin: 0;
    font-size: 2rem;
    font-weight: 700;
    color: var(--text);
  }

  .intro {
    margin-bottom: 2rem;
  }

  .intro p {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    color: var(--text);
  }

  .license-note {
    font-size: 0.9rem !important;
    color: var(--text-muted) !important;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-bottom: 3rem;
  }

  /* Override ProjectCard vars to use landing palette */
  .cards-grid :global(.project-card) {
    --sl-color-bg-nav: var(--bg-card);
    --sl-color-gray-5: var(--border);
    --sl-color-gray-4: var(--border);
    --sl-color-gray-2: var(--text-muted);
    --sl-color-text: var(--text);
    --sl-color-text-accent: var(--text);
    --sl-color-accent: var(--accent);
    --sl-color-accent-high: var(--accent-dark);
  }

  /* Glassmorphism cards over the fixed hero photo — only when there's an actual photo behind
     them to blur (a flat --bg color underneath wouldn't read as "glass", just a wash of that
     color). The card's own background must go transparent for backdrop-filter to pick up the
     real page background instead of the card's own opaque fill. Both pseudo-elements sit at a
     negative z-index so they land behind the card's normal-flow content automatically, without
     needing to touch ProjectCard.astro's markup. */
  body.has-photo .cards-grid :global(.project-card) {
    position: relative;
    background: transparent;
    border-color: transparent;
    box-shadow:
      0 0 0.75px hsl(205 20% 10% / 0.2),
      0.7px 0.8px 1.2px -0.4px hsl(205 20% 10% / 0.1),
      1.3px 1.5px 2.2px -0.8px hsl(205 20% 10% / 0.1),
      2.3px 2.6px 3.9px -1.2px hsl(205 20% 10% / 0.1),
      3.9px 4.4px 6.6px -1.7px hsl(205 20% 10% / 0.1),
      6.5px 7.2px 10.9px -2.1px hsl(205 20% 10% / 0.1),
      8px 9px 14px -2.5px hsl(205 20% 10% / 0.2);
  }

  body.has-photo .cards-grid :global(.project-card):hover {
    border-color: transparent;
    box-shadow:
      0 0 0.75px hsl(205 20% 10% / 0.3),
      0.7px 0.8px 1.2px -0.4px hsl(205 20% 10% / 0.15),
      1.3px 1.5px 2.2px -0.8px hsl(205 20% 10% / 0.15),
      2.3px 2.6px 3.9px -1.2px hsl(205 20% 10% / 0.15),
      3.9px 4.4px 6.6px -1.7px hsl(205 20% 10% / 0.15),
      6.5px 7.2px 10.9px -2.1px hsl(205 20% 10% / 0.15),
      8px 9px 14px -2.5px hsl(205 20% 10% / 0.3),
      0 4px 20px hsl(224 100% 60% / 0.15);
  }

  body.has-photo .cards-grid :global(.project-card)::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    border-radius: inherit;
    overflow: hidden;
    backdrop-filter: blur(32px) brightness(0.85) saturate(2.5);
    -webkit-backdrop-filter: blur(32px) brightness(0.85) saturate(2.5);
    transition: backdrop-filter 0.3s ease, -webkit-backdrop-filter 0.3s ease;
    background-color: hsl(189 80% 10% / 0.2);
    background-image: url('https://www.transparenttextures.com/patterns/egg-shell.png');
    background-size: 100px;
    background-repeat: repeat;
  }

  body.has-photo .cards-grid :global(.project-card):hover::before {
    backdrop-filter: blur(54px) brightness(1.05) saturate(2.5);
    -webkit-backdrop-filter: blur(54px) brightness(1.05) saturate(2.5);
  }

  body.has-photo .cards-grid :global(.project-card)::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    border-radius: inherit;
    overflow: hidden;
    box-shadow:
      inset 2px 2px 1px -3px hsl(205 20% 90% / 0.8),
      inset 4px 4px 2px -6px hsl(205 20% 90% / 0.3),
      inset 1.5px 1.5px 1.5px -0.75px hsl(205 20% 90% / 0.15),
      inset 1.5px 1.5px 0.25px hsl(205 20% 90% / 0.03),
      inset 0 0 0.25px 0.5px hsl(205 20% 90% / 0.03);
  }

  .site-footer {
    text-align: center;
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .site-footer a {
    color: var(--accent);
    text-decoration: none;
  }

  .site-footer a:hover {
    text-decoration: underline;
  }
</style>
