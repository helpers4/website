 * Copyright (C) 2025 baxyz
 * SPDX-License-Identifier: LGPL-3.0-or-later
 *
 * Starlight `Head` override — adds JSON-LD structured data (schema.org TechArticle, `about` a
 * SoftwareSourceCode) on generated typescript function pages. Gated on `entry.data.version`:
 * that field is only set by scripts/generate-typescript-docs.js on generated function reference
 * pages (see LastUpdated.astro, which uses the same signal) — hand-authored pages (comparisons,
 * philosophy, ...) have no single version/function to describe this way and get no JSON-LD.
 */
import Default from '@astrojs/starlight/components/Head.astro';

const route = Astro.locals.starlightRoute;
const { entry, lastUpdated } = route;
const { title, description, version, date, image } = entry.data;

// Starlight renders `route.head` itself: replace the site-wide og:image there rather than adding
// a second one.
if (image) {
  const imageUrl = new URL(image, Astro.site).href;
  route.head = route.head.filter((tag) => tag.attrs?.property !== 'og:image');
  route.head.push({ tag: 'meta', attrs: { property: 'og:image', content: imageUrl } });
}

const jsonLd = version
  ? {
      '@context': 'https://schema.org',
      '@type': 'TechArticle',
      headline: title,
      description,
      dateModified: lastUpdated?.toISOString(),
      about: {
        '@type': 'SoftwareSourceCode',
        name: title,
        description,
        programmingLanguage: 'TypeScript',
        codeRepository: 'https://github.com/helpers4/typescript',
        softwareVersion: version,
        license: 'https://www.gnu.org/licenses/lgpl-3.0.html',
      },
    }
  : null;

// Prevent a literal `</script>` inside a description from closing the tag early.
const jsonLdString = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
---

<Default />
<link rel="alternate" type="application/rss+xml" title="helpers4 blog" href={new URL('/blog/rss.xml', Astro.site).href} />
{date && <meta property="article:published_time" content={date.toISOString()} />}
{jsonLd && <script type="application/ld+json" set:html={jsonLdString} />}
