---
/**
 * This file is part of helpers4.
 * Copyright (C) 2025 baxyz
 * SPDX-License-Identifier: LGPL-3.0-or-later
 *
 * devcontainer.json bootstrap form (guides/devcontainer.mdx): an organization workspace (a .dev
 * repository that clones the rest of the org), opinionated on purpose. What every helpers4
 * organization has is always included and not offered as a choice; the form only asks what
 * really differs between them. Choices imply the rest: TypeScript brings package-auto-install
 * and a pinned Node, Graphite or Bitwarden bring their token variable, Angular and Vite+ bring
 * their forwarded port.
 *
 * Rendered at build time from the feature catalog written by scripts/generate-devcontainer-docs.js:
 * a feature missing from the catalog drops out, a new one shows up under "Other helpers4 features".
 * The client script writes the JSONC; nothing leaves the browser.
 */
import catalog from '../data/devcontainer-features.json';

type CatalogFeature = (typeof catalog.features)[number];
const byId = new Map<string, CatalogFeature>(catalog.features.map((f) => [f.id, f]));

/** Every feature id this form knows about, whether always included or offered. */
const KNOWN = new Set([
  'org-workspace', 'shell-history', 'dotfiles-sync', 'essential-dev', 'github-dev', 'auto-header',
  'git-absorb', 'jj', 'typescript-dev', 'package-auto-install', 'pnpm-store', 'vite-plus', 'nub',
  'playwright-dev', 'angular-dev', 'claude-dev', 'copilot-dev', 'cline-dev', 'mistral-dev',
  'kimi-dev', 'graphite-dev',
]);

/** `ghcr.io/helpers4/devcontainer/<id>:<major>`, or '' when the catalog no longer has it. */
function ref(id: string): string {
  const feature = byId.get(id);
  return feature ? `ghcr.io/helpers4/devcontainer/${id}:${feature.version.split('.')[0]}` : '';
}

function summary(id: string): string {
  const text = byId.get(id)?.description ?? '';
  return text.replace(/\s*Also self-heals your devcontainer setup\.?/, '').split(/(?<=\.)\s/)[0] ?? text;
}

const refs = Object.fromEntries([...KNOWN].map((id) => [id, ref(id)]));
const always = ['org-workspace', 'shell-history', 'dotfiles-sync', 'essential-dev', 'github-dev', 'auto-header'].filter((id) => refs[id]);
const jsTooling = [
  { id: 'pnpm-store', label: 'pnpm', checked: true },
  { id: 'vite-plus', label: 'Vite+', checked: true },
  { id: 'nub', label: 'nub', checked: false },
  { id: 'playwright-dev', label: 'Playwright', checked: false },
  { id: 'angular-dev', label: 'Angular', checked: false },
].filter((t) => refs[t.id]);
const assistants = [
  { id: 'claude-dev', label: 'Claude Code', checked: true },
  { id: 'copilot-dev', label: 'GitHub Copilot', checked: false },
  { id: 'cline-dev', label: 'Cline', checked: false },
  { id: 'mistral-dev', label: 'Mistral Vibe', checked: false },
  { id: 'kimi-dev', label: 'Kimi Code', checked: false },
  { id: 'graphite-dev', label: 'Graphite (stacked PRs)', checked: false },
].filter((a) => refs[a.id]);
const others = catalog.features.filter((f) => !KNOWN.has(f.id));
---

<form class="bootstrap" data-refs={JSON.stringify({ ...refs, ...Object.fromEntries(others.map((f) => [f.id, ref(f.id)])) })}>
  <fieldset>
    <legend>Organization</legend>
    <label class="field">
      <span>Name</span>
      <input name="name" type="text" value="my-org" required />
    </label>
    <div class="field">
      <span>License</span>
      <div class="row">
        <label><input type="radio" name="license" value="AGPL-3.0-or-later" /> AGPL</label>
        <label><input type="radio" name="license" value="LGPL-3.0-or-later" checked /> LGPL</label>
        <label><input type="radio" name="license" value="MIT" /> MIT</label>
        <label><input type="radio" name="license" value="other" /> Other</label>
        <input name="license-other" type="text" placeholder="SPDX id, e.g. Apache-2.0" aria-label="Other license (SPDX id)" />
      </div>
    </div>
    <div class="field">
      <span>Base image</span>
      <div class="row">
        <label><input type="radio" name="image" value="mcr.microsoft.com/devcontainers/typescript-node:26" checked /> TypeScript (Node 26)</label>
        <label><input type="radio" name="image" value="mcr.microsoft.com/devcontainers/base:debian" /> Debian</label>
        <label><input type="radio" name="image" value="mcr.microsoft.com/devcontainers/base:ubuntu" /> Ubuntu</label>
      </div>
    </div>
    <div class="field">
      <span>Version control</span>
      <div class="row">
        <label><input type="radio" name="vcs" value="git" checked /> Git</label>
        {refs.jj && <label><input type="radio" name="vcs" value="jj" /> jj</label>}
        {refs.jj && <label><input type="radio" name="vcs" value="both" /> Git + jj</label>}
      </div>
      <small>Git comes with Git LFS and git absorb. <a href="/devcontainer/features/jj/">jj</a> works on the same repositories (colocated).</small>
    </div>
  </fieldset>

  <fieldset>
    <legend>Languages</legend>
    <label class="choice">
      <input type="checkbox" name="typescript" checked />
      <span>TypeScript <small class="ts-hint">— with package-auto-install and a pinned Node</small></span>
    </label>
    <div class="nested js-tooling">
      {jsTooling.map((tool) => (
        <label title={summary(tool.id)}>
          <input type="checkbox" name="feature" value={tool.id} checked={tool.checked} data-group="TypeScript" />
          <a href={`/devcontainer/features/${tool.id}/`}>{tool.label}</a>
        </label>
      ))}
    </div>
    <label class="choice">
      <input type="checkbox" name="rust" />
      <span>Rust <small>— rustup, cargo, rust-analyzer</small></span>
    </label>
  </fieldset>

  <fieldset>
    <legend>AI</legend>
    <div class="row">
      {assistants.map((assistant) => (
        <label title={summary(assistant.id)}>
          <input type="checkbox" name="feature" value={assistant.id} checked={assistant.checked} data-group="AI" />
          <a href={`/devcontainer/features/${assistant.id}/`}>{assistant.label}</a>
        </label>
      ))}
    </div>
  </fieldset>

  {others.length > 0 && (
    <fieldset>
      <legend>Other helpers4 features</legend>
      {others.map((feature) => (
        <label class="choice">
          <input type="checkbox" name="feature" value={feature.id} data-group="Other" />
          <span><a href={`/devcontainer/features/${feature.id}/`}>{feature.id}</a> — {summary(feature.id)}</span>
        </label>
      ))}
    </fieldset>
  )}

  <p class="always">
    Always included:{' '}
    {always.map((id, i) => <>{i > 0 && ', '}<a href={`/devcontainer/features/${id}/`}>{id}</a></>)}, Docker outside of
    Docker, the GitHub token, Code Spell Checker and ShellCheck.
  </p>
</form>

<div class="bootstrap-output">
  <div class="bootstrap-actions">
    <strong><code>.devcontainer/devcontainer.json</code></strong>
    <button type="button" data-action="copy">Copy</button>
    <button type="button" data-action="download">Download</button>
    <span class="bootstrap-status" role="status"></span>
  </div>
  <pre><code class="bootstrap-result"></code></pre>
</div>

<script>
  type Json = string | number | boolean | null | Json[] | { [key: string]: Json };
  interface Feature { group: string; ref: string; options: Record<string, Json>; comment?: string }

  const form = document.querySelector<HTMLFormElement>('form.bootstrap');
  const result = document.querySelector<HTMLElement>('.bootstrap-result');
  const status = document.querySelector<HTMLElement>('.bootstrap-status');
  const refs: Record<string, string> = JSON.parse(form?.dataset.refs ?? '{}');

  /** Dev server ports of the features that have one: features cannot forward ports themselves. */
  const PORTS: Record<string, { port: number; label: string }> = {
    'angular-dev': { port: 4200, label: 'Angular dev server' },
    'vite-plus': { port: 5173, label: 'Vite dev server' },
  };
  /** Features that read a token: forwarded from a host variable named after the organization. */
  const TOKENS: Record<string, { variable: string; host: string }> = {
    'graphite-dev': { variable: 'GRAPHITE_TOKEN', host: 'GRAPHITE_TOKEN_FOR' },
    'bitwarden-secrets-manager': { variable: 'BWS_ACCESS_TOKEN', host: 'BWS_ACCESS_TOKEN_FOR' },
  };

  function value(json: Json, depth: number): string {
    return JSON.stringify(json, null, 2).replace(/\n/g, '\n' + '  '.repeat(depth));
  }

  function suffix(name: string): string {
    return name.toUpperCase().replace(/[^A-Z0-9]+/g, '_').replace(/^_|_$/g, '') || 'ORG';
  }

  function render(): string {
    if (!form) return '';
    const data = new FormData(form);
    const name = String(data.get('name') || 'my-org').trim();
    const licenseChoice = String(data.get('license'));
    const license = licenseChoice === 'other' ? String(data.get('license-other') || 'MIT').trim() : licenseChoice;
    const image = String(data.get('image'));
    const vcs = String(data.get('vcs') ?? 'git');
    const nodeMajor = image.match(/typescript-node:(\d+)/)?.[1];
    // The TypeScript image means a TypeScript workspace.
    const typescript = Boolean(nodeMajor) || data.get('typescript') !== null;
    const picked = new Set(
      [...form.querySelectorAll<HTMLInputElement>('input[name="feature"]:checked')]
        .filter((box) => typescript || box.dataset.group !== 'TypeScript')
        .map((box) => box.value),
    );

    const features: Feature[] = [];
    const add = (group: string, id: string, options: Record<string, Json> = {}, comment?: string) => {
      if (refs[id]) features.push({ group, ref: refs[id], options, comment });
    };

    add('Workspace', 'org-workspace', { autoDiscover: 'public,private,internal,fork' });
    add('Infrastructure', 'shell-history');
    add('Infrastructure', 'dotfiles-sync');
    features.push({ group: 'Infrastructure', ref: 'ghcr.io/devcontainers/features/docker-outside-of-docker:1', options: { moby: false } });
    if (vcs !== 'jj') {
      features.push({ group: 'Version control', ref: 'ghcr.io/devcontainers/features/git-lfs:1', options: {} });
      add('Version control', 'git-absorb');
    }
    if (vcs !== 'git') add('Version control', 'jj');
    add('Dev environment', 'essential-dev');
    add('Dev environment', 'github-dev');
    add('Dev environment', 'auto-header', { projectName: name, license });
    for (const id of ['claude-dev', 'copilot-dev', 'cline-dev', 'mistral-dev', 'kimi-dev', 'graphite-dev']) {
      if (picked.has(id)) add('AI', id, id === 'claude-dev' ? { installCli: true } : {});
    }
    if (typescript) {
      features.push({
        group: 'TypeScript',
        ref: 'ghcr.io/devcontainers/features/node:2',
        options: { version: nodeMajor ?? 'lts' },
        comment: nodeMajor
          ? `Pinned to the image's Node ${nodeMajor}: helpers4 features depend on this feature,\n    // whose default (lts) would install a second Node next to the image's own.`
          : undefined,
      });
      add('TypeScript', 'typescript-dev');
      for (const id of ['pnpm-store', 'nub', 'vite-plus', 'playwright-dev', 'angular-dev']) if (picked.has(id)) add('TypeScript', id);
      add('TypeScript', 'package-auto-install', { autoDiscover: true });
    }
    if (data.get('rust') !== null) features.push({ group: 'Rust', ref: 'ghcr.io/devcontainers/features/rust:1', options: {} });
    for (const id of picked) {
      if (!features.some((f) => f.ref === refs[id])) add('Other', id);
    }

    const env: Record<string, string> = { GH_TOKEN: `\${localEnv:GH_TOKEN_FOR_${suffix(name)}}` };
    for (const [id, token] of Object.entries(TOKENS)) {
      if (picked.has(id)) env[token.variable] = `\${localEnv:${token.host}_${suffix(name)}}`;
    }
    const hostVariables = Object.values(env).map((v) => v.slice('${localEnv:'.length, -1));

    const lines: string[] = [
      '{',
      `  "name": ${value(name, 1)},`,
      `  "image": ${value(image, 1)},`,
      '  // The .dev repository is the one opened in the container; org-workspace clones the',
      '  // other repos of the org into sibling /workspaces/<name> folders.',
      '  "workspaceFolder": "/workspaces/.dev",',
      '  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/.dev,type=bind,consistency=cached",',
      `  // Set on the host: ${hostVariables.map((v) => `export ${v}=<token>`).join('; ')}`,
      `  "containerEnv": ${value(env, 1)},`,
      `  "remoteEnv": ${value(env, 1)},`,
      '  "features": {',
    ];
    let group = '';
    features.forEach((feature, index) => {
      if (feature.group !== group) {
        group = feature.group;
        lines.push(`    // ── ${group} ${'─'.repeat(Math.max(3, 72 - group.length))}`);
      }
      if (feature.comment) lines.push(`    // ${feature.comment}`);
      const comma = index < features.length - 1 ? ',' : '';
      lines.push(`    ${value(feature.ref, 2)}: ${value(feature.options, 2)}${comma}`);
    });
    lines.push('  },');
    const extensions = ['streetsidesoftware.code-spell-checker', 'timonwong.shellcheck'];
    lines.push(`  "customizations": ${value({ vscode: { extensions } }, 1)},`);
    const ports = Object.entries(PORTS).filter(([id]) => picked.has(id) && typescript).map(([, p]) => p);
    if (ports.length) {
      lines.push(
        '  // Dev servers must listen on 0.0.0.0 (--host) to be reachable from the host browser.',
        `  "forwardPorts": ${value(ports.map((p) => p.port), 1)},`,
        `  "portsAttributes": ${value(Object.fromEntries(ports.map((p) => [String(p.port), { label: p.label, onAutoForward: 'notify' }])), 1)},`,
      );
    }
    lines.push(`  "remoteUser": ${value(nodeMajor ? 'node' : 'vscode', 1)}`, '}');
    return lines.join('\n') + '\n';
  }

  /** Keeps the form consistent: TypeScript is implied by its image, its tooling hides without it. */
  function sync() {
    if (!form) return;
    const data = new FormData(form);
    const tsImage = /typescript-node/.test(String(data.get('image')));
    const tsBox = form.querySelector<HTMLInputElement>('input[name="typescript"]');
    if (tsBox) {
      if (tsImage) tsBox.checked = true;
      tsBox.disabled = tsImage;
    }
    form.querySelector<HTMLElement>('.js-tooling')?.toggleAttribute('hidden', !(tsBox?.checked ?? false));
    const other = form.querySelector<HTMLInputElement>('input[name="license-other"]');
    if (other) other.disabled = data.get('license') !== 'other';
  }

  function update() {
    sync();
    if (result) result.textContent = render();
  }

  function say(message: string) {
    if (!status) return;
    status.textContent = message;
    setTimeout(() => (status.textContent = ''), 2000);
  }

  form?.addEventListener('input', update);
  form?.addEventListener('change', update);
  document.querySelector('[data-action="copy"]')?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(render());
      say('Copied');
    } catch {
      say('Copy failed: select the text instead');
    }
  });
  document.querySelector('[data-action="download"]')?.addEventListener('click', () => {
    const url = URL.createObjectURL(new Blob([render()], { type: 'application/json' }));
    const link = Object.assign(document.createElement('a'), { href: url, download: 'devcontainer.json' });
    link.click();
    URL.revokeObjectURL(url);
  });
  update();
</script>

<style>
  .bootstrap fieldset {
    margin: 1.5rem 0 0;
    padding: 0.75rem 1rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
  }

  .bootstrap legend {
    padding: 0 0.4rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .bootstrap .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 0.75rem;
  }

  .bootstrap .field > span {
    font-weight: 600;
  }

  .bootstrap .row,
  .bootstrap .nested {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
  }

  .bootstrap .nested {
    margin: 0.4rem 0 0.6rem 1.6rem;
  }

  .bootstrap .nested[hidden] {
    display: none;
  }

  .bootstrap label {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .bootstrap .choice {
    display: flex;
    margin-top: 0.5rem;
  }

  .bootstrap small,
  .bootstrap .always {
    color: var(--sl-color-gray-3);
  }

  .bootstrap .always {
    margin-top: 1rem;
    font-size: var(--sl-text-sm);
  }

  .bootstrap input[type='text'] {
    max-width: 20rem;
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.25rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font: inherit;
  }

  .bootstrap input[type='text']:disabled {
    opacity: 0.5;
  }

  .bootstrap-output {
    margin-top: 2rem;
  }

  .bootstrap-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .bootstrap-actions button {
    padding: 0.3rem 0.9rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: 0.25rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
    font: inherit;
    cursor: pointer;
  }

  .bootstrap-actions button:hover {
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
  }

  .bootstrap-status {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .bootstrap-output pre {
    max-height: 32rem;
    overflow: auto;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-6);
    font-size: var(--sl-text-xs);
  }
</style>
