---
/**
 * This file is part of helpers4.
 * Copyright (C) 2025 baxyz
 * SPDX-License-Identifier: LGPL-3.0-or-later
 *
 * devcontainer.json bootstrap form (guides/devcontainer.mdx). The form is rendered at build time
 * from the feature catalog written by scripts/generate-devcontainer-docs.js, so a feature that is
 * removed disappears and a new one shows up under "Other helpers4 features" with no edit here.
 * GROUPS below is the curated part: the pre-checked boxes are what every helpers4 organization
 * devcontainer (baxyz, helpers4, tuxery, feature-today, brig-id) has in common. The client script
 * reads the form and writes the JSONC; nothing leaves the browser.
 */
import catalog from '../data/devcontainer-features.json';

interface Choice {
  key: string;
  ref: string;
  label: string;
  description: string;
  docs: string;
  checked: boolean;
  /** Options written as they are; options that depend on the form are set by the script. */
  options?: Record<string, unknown>;
  /** Needs Node.js in the container: pulls in the pinned node feature. */
  node?: boolean;
  note?: string;
}

interface Group {
  label: string;
  items: Choice[];
}

type CatalogFeature = (typeof catalog.features)[number];
const byId = new Map<string, CatalogFeature>(catalog.features.map((f) => [f.id, f]));
const used = new Set<string>(['org-workspace']);

function shortDescription(text: string): string {
  return text.replace(/\s*Also self-heals your devcontainer setup\.?/, '').split(/(?<=\.)\s/)[0] ?? text;
}

/** A helpers4 feature, or nothing when the catalog no longer has it. */
function h(id: string, checked: boolean, extra: Partial<Choice> = {}): Choice[] {
  const feature = byId.get(id);
  if (!feature) return [];
  used.add(id);
  return [
    {
      key: id,
      ref: `ghcr.io/helpers4/devcontainer/${id}:${feature.version.split('.')[0]}`,
      label: id,
      description: shortDescription(feature.description),
      docs: `/devcontainer/features/${id}/`,
      checked,
      ...extra,
    },
  ];
}

/** A feature from outside helpers4. */
function ext(key: string, ref: string, description: string, docs: string, checked: boolean, extra: Partial<Choice> = {}): Choice[] {
  return [{ key, ref, label: key, description, docs, checked, ...extra }];
}

const GROUPS: Group[] = [
  {
    label: 'Infrastructure',
    items: [
      ...h('shell-history', true),
      ...ext(
        'docker-outside-of-docker',
        'ghcr.io/devcontainers/features/docker-outside-of-docker:1',
        'The docker CLI and compose, talking to the host engine.',
        'https://github.com/devcontainers/features/tree/main/src/docker-outside-of-docker',
        true,
        // The Debian trixie images no longer package moby-cli.
        { options: { moby: false } },
      ),
      ...ext(
        'devcontainers-cli',
        'ghcr.io/devcontainers-extra/features/devcontainers-cli:1',
        'The devcontainer CLI, to build and test containers from inside.',
        'https://github.com/devcontainers-extra/features/tree/main/src/devcontainers-cli',
        false,
      ),
      ...h('dotfiles-sync', false, { note: 'Bind-mounts host files: breaks on Codespaces.' }),
    ],
  },
  {
    label: 'Git & GitHub',
    items: [
      ...ext('git-lfs', 'ghcr.io/devcontainers/features/git-lfs:1', 'Git Large File Storage.', 'https://github.com/devcontainers/features/tree/main/src/git-lfs', true),
      ...h('git-absorb', true),
      ...h('essential-dev', true),
      ...h('github-dev', true),
      ...h('auto-header', true, { note: 'Uses the name and license above.' }),
      ...h('jj', false),
      ...h('graphite-dev', false, { node: true, note: 'Reads GRAPHITE_TOKEN from the environment.' }),
    ],
  },
  {
    label: 'AI assistants',
    items: [
      ...h('claude-dev', true, { options: { installCli: true } }),
      ...h('copilot-dev', false),
      ...h('cline-dev', false),
      ...h('mistral-dev', false),
      ...h('kimi-dev', false),
    ],
  },
  {
    label: 'JavaScript & TypeScript',
    items: [
      ...h('typescript-dev', true, { node: true }),
      ...h('pnpm-store', true, { node: true }),
      ...h('package-auto-install', true, { node: true }),
      ...h('vite-plus', true, { node: true }),
      ...h('nub', false, { node: true }),
      ...h('playwright-dev', false, { node: true }),
      ...h('angular-dev', false, { node: true }),
    ],
  },
  {
    label: 'Rust',
    items: [
      ...ext('rust', 'ghcr.io/devcontainers/features/rust:1', 'rustup, cargo and the rust-analyzer extension.', 'https://github.com/devcontainers/features/tree/main/src/rust', false),
    ],
  },
  { label: 'Secrets', items: [...h('bitwarden-secrets-manager', false)] },
];

const others = catalog.features.filter((f) => !used.has(f.id)).flatMap((f) => h(f.id, false));
const groups = [...GROUPS, ...(others.length ? [{ label: 'Other helpers4 features', items: others }] : [])].filter(
  (g) => g.items.length > 0,
);
const orgWorkspace = byId.get('org-workspace');
---

<form class="bootstrap" data-org-workspace-ref={orgWorkspace ? `ghcr.io/helpers4/devcontainer/org-workspace:${orgWorkspace.version.split('.')[0]}` : ''}>
  <fieldset>
    <legend>Project</legend>
    <label class="field">
      <span>Name</span>
      <input name="name" type="text" value="my-org" required />
      <small>Organization or project name: container name, file headers, token variable.</small>
    </label>
    <div class="field">
      <span>Layout</span>
      {orgWorkspace && (
        <label class="inline">
          <input type="radio" name="layout" value="org" checked />
          Organization workspace — a <code>.dev</code> repository that clones every repo of the org next to it
        </label>
      )}
      <label class="inline">
        <input type="radio" name="layout" value="repo" checked={!orgWorkspace} />
        Single repository
      </label>
    </div>
    <label class="field">
      <span>Base image</span>
      <select name="image">
        <option value="mcr.microsoft.com/devcontainers/typescript-node:26" selected>typescript-node:26 (Node 26)</option>
        <option value="mcr.microsoft.com/devcontainers/typescript-node:24">typescript-node:24 (Node 24)</option>
        <option value="mcr.microsoft.com/devcontainers/base:debian">base:debian (no Node)</option>
      </select>
    </label>
    <label class="field">
      <span>License</span>
      <input name="license" type="text" value="LGPL-3.0-or-later" list="bootstrap-licenses" />
      <datalist id="bootstrap-licenses">
        <option value="LGPL-3.0-or-later"></option>
        <option value="AGPL-3.0-or-later"></option>
        <option value="AGPL-3.0-only"></option>
        <option value="GPL-3.0-or-later"></option>
        <option value="MIT"></option>
        <option value="Apache-2.0"></option>
      </datalist>
      <small>SPDX identifier, written in every new file header by auto-header.</small>
    </label>
    <label class="inline">
      <input type="checkbox" name="token" checked />
      Forward a GitHub token from the host (<code class="token-name">GH_TOKEN_FOR_MY_ORG</code>)
    </label>
  </fieldset>

  {groups.map((group) => (
    <fieldset>
      <legend>{group.label}</legend>
      {group.items.map((item) => (
        <label class="choice">
          <input
            type="checkbox"
            name="feature"
            value={item.key}
            checked={item.checked}
            data-ref={item.ref}
            data-group={group.label}
            data-options={JSON.stringify(item.options ?? {})}
            data-node={item.node ? 'true' : undefined}
          />
          <span>
            <a href={item.docs}>{item.label}</a> — {item.description}
            {item.note && <em> {item.note}</em>}
          </span>
        </label>
      ))}
    </fieldset>
  ))}

  <fieldset>
    <legend>Editor and ports</legend>
    <label class="inline">
      <input type="checkbox" name="extension" value="streetsidesoftware.code-spell-checker" checked />
      Code Spell Checker
    </label>
    <label class="inline">
      <input type="checkbox" name="extension" value="timonwong.shellcheck" checked />
      ShellCheck
    </label>
    <label class="field">
      <span>Forwarded ports</span>
      <input name="ports" type="text" placeholder="4321, 5173" inputmode="numeric" />
      <small>Comma-separated. Dev servers must listen on 0.0.0.0 to be reachable from the host.</small>
    </label>
  </fieldset>
</form>

<div class="bootstrap-output">
  <div class="bootstrap-actions">
    <strong><code>.devcontainer/devcontainer.json</code></strong>
    <button type="button" data-action="copy">Copy</button>
    <button type="button" data-action="download">Download</button>
    <span class="bootstrap-status" role="status"></span>
  </div>
  <pre><code class="bootstrap-result"></code></pre>
</div>

<script>
  type Json = string | number | boolean | null | Json[] | { [key: string]: Json };

  const form = document.querySelector<HTMLFormElement>('form.bootstrap');
  const result = document.querySelector<HTMLElement>('.bootstrap-result');
  const status = document.querySelector<HTMLElement>('.bootstrap-status');

  /** A JSON value indented to sit at `depth` inside the generated file. */
  function value(json: Json, depth: number): string {
    return JSON.stringify(json, null, 2).replace(/\n/g, '\n' + '  '.repeat(depth));
  }

  function tokenName(name: string): string {
    const slug = name.toUpperCase().replace(/[^A-Z0-9]+/g, '_').replace(/^_|_$/g, '');
    return `GH_TOKEN_FOR_${slug || 'ORG'}`;
  }

  function render(): string {
    if (!form) return '';
    const data = new FormData(form);
    const name = String(data.get('name') || 'my-org').trim();
    const layout = String(data.get('layout') ?? 'repo');
    const image = String(data.get('image'));
    const license = String(data.get('license') || 'MIT').trim();
    const nodeMajor = image.match(/typescript-node:(\d+)/)?.[1];

    // Features, in group order, with the options that depend on the form.
    const boxes = [...form.querySelectorAll<HTMLInputElement>('input[name="feature"]:checked')];
    const features: { group: string; ref: string; options: Record<string, Json>; comment?: string }[] = [];
    if (layout === 'org' && form.dataset.orgWorkspaceRef) {
      features.push({
        group: 'Workspace',
        ref: form.dataset.orgWorkspaceRef,
        options: { autoDiscover: 'public,private,internal,fork' },
      });
    }
    let nodeAdded = false;
    for (const box of boxes) {
      const options: Record<string, Json> = JSON.parse(box.dataset.options ?? '{}');
      if (box.value === 'auto-header') Object.assign(options, { projectName: name, license });
      if (box.value === 'package-auto-install' && layout === 'org') options.autoDiscover = true;
      if (box.dataset.node && !nodeAdded) {
        nodeAdded = true;
        features.push({
          group: box.dataset.group ?? '',
          ref: 'ghcr.io/devcontainers/features/node:2',
          options: { version: nodeMajor ?? 'lts' },
          comment: nodeMajor
            ? `Pinned to the image's Node ${nodeMajor}: helpers4 features depend on this feature,\n    // whose default (lts) would install a second Node next to the image's own.`
            : undefined,
        });
      }
      features.push({ group: box.dataset.group ?? '', ref: box.dataset.ref ?? '', options });
    }

    const lines: string[] = ['{', `  "name": ${value(name, 1)},`, `  "image": ${value(image, 1)},`];
    if (layout === 'org') {
      lines.push(
        '  // The .dev repository is the one opened in the container; org-workspace clones the',
        '  // other repos of the org into sibling /workspaces/<name> folders.',
        '  "workspaceFolder": "/workspaces/.dev",',
        '  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/.dev,type=bind,consistency=cached",',
      );
    }
    if (data.get('token')) {
      const env = { GH_TOKEN: `\${localEnv:${tokenName(name)}}` };
      lines.push(
        `  // Set on the host: export ${tokenName(name)}=<token>`,
        `  "containerEnv": ${value(env, 1)},`,
        `  "remoteEnv": ${value(env, 1)},`,
      );
    }
    lines.push('  "features": {');
    let group = '';
    features.forEach((feature, index) => {
      if (feature.group !== group) {
        group = feature.group;
        lines.push(`    // ── ${group} ${'─'.repeat(Math.max(3, 72 - group.length))}`);
      }
      if (feature.comment) lines.push(`    // ${feature.comment}`);
      const comma = index < features.length - 1 ? ',' : '';
      lines.push(`    ${value(feature.ref, 2)}: ${value(feature.options, 2)}${comma}`);
    });
    lines.push('  },');

    const extensions = data.getAll('extension').map(String);
    if (extensions.length) lines.push(`  "customizations": ${value({ vscode: { extensions } }, 1)},`);
    const ports = String(data.get('ports') ?? '')
      .split(/[\s,]+/)
      .map(Number)
      .filter((port) => Number.isInteger(port) && port > 0 && port < 65536);
    if (ports.length) lines.push(`  "forwardPorts": ${value(ports, 1)},`);
    lines.push(`  "remoteUser": ${value(nodeMajor ? 'node' : 'vscode', 1)}`, '}');
    return lines.join('\n') + '\n';
  }

  function update() {
    if (!form || !result) return;
    result.textContent = render();
    const name = String(new FormData(form).get('name') || 'my-org');
    form.querySelectorAll('.token-name').forEach((el) => (el.textContent = tokenName(name)));
  }

  function say(message: string) {
    if (!status) return;
    status.textContent = message;
    setTimeout(() => (status.textContent = ''), 2000);
  }

  form?.addEventListener('input', update);
  form?.addEventListener('change', update);
  document.querySelector('[data-action="copy"]')?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(render());
      say('Copied');
    } catch {
      say('Copy failed: select the text instead');
    }
  });
  document.querySelector('[data-action="download"]')?.addEventListener('click', () => {
    const url = URL.createObjectURL(new Blob([render()], { type: 'application/json' }));
    const link = Object.assign(document.createElement('a'), { href: url, download: 'devcontainer.json' });
    link.click();
    URL.revokeObjectURL(url);
  });
  update();
</script>

<style>
  .bootstrap fieldset {
    margin: 1.5rem 0 0;
    padding: 0.75rem 1rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
  }

  .bootstrap legend {
    padding: 0 0.4rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .bootstrap .field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 0.75rem;
  }

  .bootstrap .field > span {
    font-weight: 600;
  }

  .bootstrap small {
    color: var(--sl-color-gray-3);
  }

  .bootstrap input[type='text'],
  .bootstrap select {
    max-width: 28rem;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.25rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font: inherit;
  }

  .bootstrap .inline,
  .bootstrap .choice {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .bootstrap .choice em {
    color: var(--sl-color-gray-3);
  }

  .bootstrap-output {
    margin-top: 2rem;
  }

  .bootstrap-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .bootstrap-actions button {
    padding: 0.3rem 0.9rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: 0.25rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
    font: inherit;
    cursor: pointer;
  }

  .bootstrap-actions button:hover {
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
  }

  .bootstrap-status {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .bootstrap-output pre {
    max-height: 32rem;
    overflow: auto;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-6);
    font-size: var(--sl-text-xs);
  }
</style>
