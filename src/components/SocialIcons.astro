---
/**
 * This file is part of helpers4.
 * Copyright (C) 2025 baxyz
 * SPDX-License-Identifier: LGPL-3.0-or-later
 *
 * Starlight `SocialIcons` override. Two changes from the default (see
 * node_modules/@astrojs/starlight/components/SocialIcons.astro):
 *  - the GitHub link points at the repo for the section being browsed (helpers4/typescript,
 *    helpers4/devcontainer, helpers4/action) instead of the generic helpers4 org page — same idea
 *    as the per-repo GitHub button already on ProjectCard.astro / the homepage.
 *  - that repo's live star count and OpenSSF Scorecard score are shown alongside it, via the
 *    same memoized build-time fetch as the homepage (../lib/repoStats.ts).
 */
import { Icon } from '@astrojs/starlight/components';
import config from 'virtual:starlight/user-config';
import { getRepoStats } from '../lib/repoStats';

const SECTION_REPOS: Record<string, string> = {
  typescript: 'helpers4/typescript',
  devcontainer: 'helpers4/devcontainer',
  action: 'helpers4/action',
};

const section = Astro.locals.starlightRoute.entry.id.split('/')[0] ?? '';
const repoPath = SECTION_REPOS[section];
const { stars, scorecard, coverage } = repoPath
  ? await getRepoStats(repoPath)
  : { stars: null, scorecard: null, coverage: null };

const links = (config.social ?? []).map((link) =>
  link.icon === 'github' && repoPath ? { ...link, href: `https://github.com/${repoPath}` } : link,
);

function formatStars(value: number): string {
  return value >= 1000 ? `${(value / 1000).toFixed(1)}k` : String(value);
}

// OpenSSF's own badge thresholds (score is 0–10).
function scorecardColor(score: number): string {
  if (score >= 7) return 'var(--sl-color-green)';
  if (score >= 4) return 'var(--sl-color-orange)';
  return 'var(--sl-color-red)';
}

function coverageColor(pct: number): string {
  if (pct >= 90) return 'var(--sl-color-green)';
  if (pct >= 70) return 'var(--sl-color-orange)';
  return 'var(--sl-color-red)';
}
---

{scorecard !== null && (
  <a
    href={`https://scorecard.dev/viewer/?uri=github.com/${repoPath}`}
    class="sl-flex header-badge"
    style={`--badge-color: ${scorecardColor(scorecard)}`}
    target="_blank"
    rel="noopener noreferrer"
    title={`OpenSSF Scorecard: ${scorecard.toFixed(1)}/10`}
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 1 3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
    </svg>
    {scorecard.toFixed(1)}
  </a>
)}
{coverage !== null && (
  <a
    href={`https://codecov.io/github/${repoPath}`}
    class="sl-flex header-badge"
    style={`--badge-color: ${coverageColor(coverage)}`}
    target="_blank"
    rel="noopener noreferrer"
    title={`Test coverage: ${coverage}%`}
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 6 9 17l-5-5"/>
    </svg>
    {coverage}%
  </a>
)}
{stars !== null && (
  <a
    href={`https://github.com/${repoPath}`}
    class="sl-flex header-badge"
    target="_blank"
    rel="noopener noreferrer"
    title={`${stars} stars on GitHub`}
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
    </svg>
    {formatStars(stars)}
  </a>
)}
{links.length > 0 && (
  <>
    {links.map(({ label, href, icon }) => (
      <a href={href} rel="me" class="sl-flex">
        <span class="sr-only">{label}</span>
        <Icon name={icon} />
      </a>
    ))}
  </>
)}

<style>
  @layer starlight.core {
    a {
      color: var(--sl-color-text-accent);
      padding: 0.5em;
      margin: -0.5em;
    }
    a:hover {
      color: var(--sl-color-white);
    }
  }

  .header-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    padding: 0.2rem 0.55rem !important;
    margin: 0 !important;
    border-radius: 0.375rem;
    border: 1px solid var(--sl-color-gray-5);
    color: var(--badge-color, var(--sl-color-gray-2));
  }

  .header-badge:hover {
    color: var(--badge-color, var(--sl-color-white));
    border-color: var(--badge-color, var(--sl-color-gray-4));
  }
</style>
