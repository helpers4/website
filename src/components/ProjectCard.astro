export interface ProjectCard {
  title: string;
  label: string;
  description: string;
  docsHref: string;
  repoPath: string;
}

interface Props {
  card: ProjectCard;
  stars: number | null;
  scorecard: number | null;
  coverage: number | null;
}

const { card, stars, scorecard, coverage } = Astro.props;

function formatStars(value: number | null): string {
  if (value === null) return '–';
  if (value >= 1000) return `${(value / 1000).toFixed(1)}k`;
  return String(value);
}

// OpenSSF's own badge thresholds (score is 0–10).
function scorecardColor(score: number): string {
  if (score >= 7) return 'var(--sl-color-green)';
  if (score >= 4) return 'var(--sl-color-orange)';
  return 'var(--sl-color-red)';
}

function coverageColor(pct: number): string {
  if (pct >= 90) return 'var(--sl-color-green)';
  if (pct >= 70) return 'var(--sl-color-orange)';
  return 'var(--sl-color-red)';
}
---

<div class="project-card">
  <div class="card-header">
    <h3>{card.title}</h3>
  </div>

  <p class="card-description">{card.description}</p>

  <div class="card-footer">
    <a href={card.docsHref} class="btn btn-primary">
      Open {card.label} docs
    </a>
    <a
      href={`https://github.com/${card.repoPath}`}
      class="btn btn-outline"
      target="_blank"
      rel="noopener noreferrer"
    >
      GitHub
    </a>
    <div class="badge-group">
      {scorecard !== null && (
        <a
          href={`https://scorecard.dev/viewer/?uri=github.com/${card.repoPath}`}
          class="scorecard-badge"
          style={`--scorecard-color: ${scorecardColor(scorecard)}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`OpenSSF Scorecard: ${scorecard.toFixed(1)} out of 10 — view per-check breakdown`}
          title={`OpenSSF Scorecard: ${scorecard.toFixed(1)}/10`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 1 3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
          </svg>
          {scorecard.toFixed(1)}
        </a>
      )}
      {coverage !== null && (
        <a
          href={`https://codecov.io/github/${card.repoPath}`}
          class="coverage-badge"
          style={`--coverage-color: ${coverageColor(coverage)}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Test coverage: ${coverage}%`}
          title={`Test coverage: ${coverage}%`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6 9 17l-5-5"/>
          </svg>
          {coverage}%
        </a>
      )}
      <a
        href={`https://github.com/${card.repoPath}`}
        class="stars-badge"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${formatStars(stars)} stars on GitHub`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        {formatStars(stars)}
      </a>
    </div>
  </div>
</div>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-bg-nav);
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .project-card:hover {
    border-color: var(--sl-color-accent);
    box-shadow: 0 2px 16px color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
  }

  .card-header h3 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--sl-color-text-accent);
  }

  .scorecard-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.85rem;
    color: var(--scorecard-color);
    text-decoration: none;
    padding: 0.2rem 0.5rem;
    border-radius: 0.375rem;
    border: 1px solid var(--scorecard-color);
    transition: opacity 0.2s;
  }

  .scorecard-badge:hover {
    opacity: 0.75;
  }

  .coverage-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.85rem;
    color: var(--coverage-color);
    text-decoration: none;
    padding: 0.2rem 0.5rem;
    border-radius: 0.375rem;
    border: 1px solid var(--coverage-color);
    transition: opacity 0.2s;
  }

  .coverage-badge:hover {
    opacity: 0.75;
  }

  .stars-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.85rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    padding: 0.2rem 0.5rem;
    border-radius: 0.375rem;
    border: 1px solid var(--sl-color-gray-5);
    transition: color 0.2s;
  }

  .stars-badge:hover {
    color: var(--sl-color-text-accent);
  }

  .card-description {
    margin: 0;
    font-size: 0.95rem;
    color: var(--sl-color-gray-2);
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .badge-group {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .btn-primary {
    background: var(--sl-color-accent);
    color: #fff;
    border: 1px solid transparent;
  }

  .btn-primary:hover {
    background: var(--sl-color-accent-high);
  }

  .btn-outline {
    background: transparent;
    color: var(--sl-color-text);
    border: 1px solid var(--sl-color-gray-4);
  }

  .btn-outline:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
  }
</style>
