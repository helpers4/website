export interface ProjectCard {
  title: string;
  label: string;
  description: string;
  docsHref: string;
  repoPath: string;
}

interface Props {
  card: ProjectCard;
  stars: number | null;
  scorecard: number | null;
  coverage: number | null;
}

const { card, stars, scorecard, coverage } = Astro.props;

function formatStars(value: number | null): string {
  if (value === null) return '–';
  if (value >= 1000) return `${(value / 1000).toFixed(1)}k`;
  return String(value);
}

// The "-high" variant, not the bare token: starlight-theme-nova remaps --sl-color-green/orange/red
// to dark, background-appropriate shades in dark mode (paired with a light "-high" foreground
// counterpart) — using the bare token as text color makes it nearly invisible on a dark card.
// OpenSSF's own badge thresholds (score is 0–10).
function scorecardColor(score: number): string {
  if (score >= 7) return 'var(--sl-color-green-high)';
  if (score >= 4) return 'var(--sl-color-orange-high)';
  return 'var(--sl-color-red-high)';
}

function coverageColor(pct: number): string {
  if (pct >= 90) return 'var(--sl-color-green-high)';
  if (pct >= 70) return 'var(--sl-color-orange-high)';
  return 'var(--sl-color-red-high)';
}
---

<a href={card.docsHref} class="project-card" aria-label={`Open ${card.label} docs`}>
  <div class="card-header">
    <h3>{card.title}</h3>
  </div>

  <p class="card-description">{card.description}</p>

  <div class="card-stats">
    <span class="stat" title={`${stars ?? '?'} stars on GitHub`}>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
      </svg>
      <span class="stat-label">Stars</span>
      <span class="stat-value" style="color: var(--sl-color-orange-high)">{formatStars(stars)}</span>
    </span>
    {scorecard !== null && (
      <span class="stat" title={`OpenSSF Scorecard: ${scorecard.toFixed(1)}/10`}>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 1 3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
        </svg>
        <span class="stat-label">Scorecard</span>
        <span class="stat-value" style={`color: ${scorecardColor(scorecard)}`}>{scorecard.toFixed(1)}</span>
      </span>
    )}
    {coverage !== null && (
      <span class="stat" title={`Test coverage: ${coverage}%`}>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 12a10.06 10.06 1 0 0-20 0Z"/>
          <path d="M12 12v8a2 2 0 0 0 4 0"/>
          <path d="M12 2v1"/>
        </svg>
        <span class="stat-label">Coverage</span>
        <span class="stat-value" style={`color: ${coverageColor(coverage)}`}>{coverage}%</span>
      </span>
    )}
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-bg-nav);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .project-card:hover {
    border-color: var(--sl-color-accent);
    box-shadow: 0 2px 16px color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
  }

  .card-header h3 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--sl-color-text-accent);
  }

  .card-description {
    margin: 0;
    font-size: 0.95rem;
    color: var(--sl-color-gray-2);
    flex: 1;
  }

  .card-stats {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .stat {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
  }

  .stat-value {
    font-weight: 600;
    color: var(--sl-color-gray-2);
  }
</style>
