# Copy to .env and fill in for local dev. In CI/production, set as a repo secret instead
# (see .github/workflows/deploy.yml).

# Unsplash API access key — used to fetch one random "technology, abstract" photo for the landing
# page hero at build time. Get one at https://unsplash.com/oauth/applications (free tier).
# Optional: without it, the landing page just renders without a hero photo.
UNSPLASH_ACCESS_KEY=
